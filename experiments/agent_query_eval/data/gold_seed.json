  "principle_records": [
    {
      "id": "PR-DATUM-AXIS-001",
      "knowledge_type": "principle",
      "subtype": "datum_selection",
      "topic": "轴类零件基准选择",
      "principle_text": "轴类零件制定工艺路线时，应先考虑可靠定位和统一基准。常以中心孔、主要轴颈或已加工端面作为后续精加工和检验的定位基准。",
      "applicable_scenario": "轴类零件、传动轴、齿轮轴工艺路线规划",
      "source_doc": "工艺知识库.pdf",
      "source_page": 106,
      "chapter_path": "第3章 机械加工工艺规程制订",
      "source_text": "输出轴案例中先钻中心孔，后续精车、磨削均采用一夹一顶或两顶尖装夹。",
      "quality_status": "accepted",
      "tags": ["轴类", "基准", "中心孔", "路线规划"]
    },
    {
      "id": "PR-DATUM-FIRST-001",
      "knowledge_type": "principle",
      "subtype": "operation_sequence",
      "topic": "先加工基准面",
      "principle_text": "机械加工路线通常先加工定位基准，再以稳定基准加工其他表面，以减少装夹误差传递并保证相互位置精度。",
      "applicable_scenario": "通用工艺路线规划",
      "source_doc": "工艺知识库.pdf",
      "source_page": 114,
      "chapter_path": "第3章 机械加工工艺规程制订",
      "source_text": "轴承座等案例先安排底面、侧面或基准孔加工，再安排孔系和相关表面加工。",
      "quality_status": "accepted",
      "tags": ["基准", "工序顺序", "位置精度"]
    },
    {
      "id": "PR-THIN-WALL-001",
      "knowledge_type": "principle",
      "subtype": "thin_wall_processing",
      "topic": "薄壁缸套粗精分开",
      "principle_text": "薄壁零件刚性差，车削时易受切削力和夹紧力影响产生变形。应合理选择装夹方法、刀具角度、切削用量和冷却润滑，并注意粗精分开。",
      "applicable_scenario": "薄壁缸套、套类零件",
      "source_doc": "工艺知识库.pdf",
      "source_page": 108,
      "chapter_path": "第3章 机械加工工艺规程制订",
      "source_text": "缸套属于薄壁零件。由于薄壁工件的刚性差，在车削过程中受切削力和夹紧力的作用极易产生变形。零件内圆和外圆精度要求较高，加工时应粗、精分开。",
      "quality_status": "accepted",
      "tags": ["薄壁", "缸套", "粗精分开", "装夹变形"]
    },
    {
      "id": "PR-HEAT-TREAT-001",
      "knowledge_type": "principle",
      "subtype": "heat_treatment_arrangement",
      "topic": "热处理工序安排",
      "principle_text": "有调质、正火或时效要求时，应结合毛坯状态、粗加工应力和最终精度要求安排热处理。常见做法是在下料或粗加工后安排调质、正火或时效，再进行精加工。",
      "applicable_scenario": "有热处理要求的轴类、套类、铸件",
      "source_doc": "工艺知识库.pdf",
      "source_page": 106,
      "chapter_path": "第3章 机械加工工艺规程制订",
      "source_text": "输出轴案例在下料后安排调质处理 28～32HRC；缸套案例安排人工时效和正火 190～207HBW。",
      "quality_status": "accepted",
      "tags": ["热处理", "调质", "正火", "时效"]
    },
    {
      "id": "PR-INSPECTION-KEYSLOT-001",

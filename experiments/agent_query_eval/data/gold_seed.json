  "computation_methods": [
    {
      "id": "CM-DIM-CHAIN-BASIC-001",
      "knowledge_type": "computation",
      "method_id": "calculate_closed_loop_basic_size",
      "topic": "尺寸链封闭环基本尺寸",
      "method_name": "计算封闭环的基本尺寸",
      "formula": "L0 = sum(xi_i * L_i)",
      "inputs_json": [{"name": "xi", "type": "list[float]"}, {"name": "Li", "type": "list[float]", "unit": "mm"}],
      "outputs_json": [{"name": "L0", "type": "float", "unit": "mm"}],
      "implementation_status": "not_implemented",
      "verified": false,
      "source_doc": "工艺知识库.pdf",
      "source_page": 86,
      "source_text": "L_0 = Σ ξ_i L_i",
      "quality_status": "accepted",
      "tags": ["尺寸链", "封闭环"]
    },
    {
      "id": "CM-DIM-CHAIN-TOL-001",
      "knowledge_type": "computation",
      "method_id": "calculate_extreme_tolerance",
      "topic": "封闭环极值公差",
      "method_name": "计算封闭环的极值公差",
      "formula": "T0L = sum(abs(xi_i) * T_i)",
      "inputs_json": [{"name": "xi", "type": "list[float]"}, {"name": "Ti", "type": "list[float]", "unit": "mm"}],
      "outputs_json": [{"name": "T0L", "type": "float", "unit": "mm"}],
      "implementation_status": "not_implemented",
      "verified": false,
      "source_doc": "工艺知识库.pdf",
      "source_page": 86,
      "source_text": "T_{0L} = Σ |ξ_i| T_i",
      "quality_status": "accepted",
      "tags": ["尺寸链", "公差"]
    },
    {
      "id": "CM-PROCESS-TOL-DIST-001",
      "knowledge_type": "computation",
      "method_id": "calculate_process_tolerance_distribution",
      "topic": "基准不重合工序尺寸公差分配",
      "method_name": "工序尺寸公差分配",
      "formula": "T_av,L = T_0L / n",
      "inputs_json": [{"name": "T_0L", "type": "float", "unit": "mm"}, {"name": "n", "type": "int"}],
      "outputs_json": [{"name": "T_av_L", "type": "float", "unit": "mm"}],
      "implementation_status": "not_implemented",
      "verified": true,
      "source_doc": "工艺知识库.pdf",
      "source_page": 88,
      "source_text": "T_0L = ΣT_i；T_av,L = T_0L / n",
      "quality_status": "accepted",
      "tags": ["基准不重合", "工序尺寸", "公差分配"]
    },
    {
      "id": "CM-ALLOW-FINISH-GRIND-001",
      "knowledge_type": "computation",
      "method_id": "calculate_finish_to_grind_allowance",
      "topic": "精车到磨削余量",
      "method_name": "由前后工序直径计算余量",
      "formula": "diameter_allowance = abs(D_grind - D_finish); single_side = diameter_allowance / 2",
      "inputs_json": [{"name": "D_finish", "type": "float", "unit": "mm"}, {"name": "D_grind", "type": "float", "unit": "mm"}],
